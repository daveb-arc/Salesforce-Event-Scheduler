    <script>
    function initDatePickers() {
        jQuery(".appt-date").each(function() {
            var $el = jQuery(this);

            if ($el.hasClass("hasDatepicker")) {
                $el.datepicker("destroy");
            }

            $el.datepicker({
                numberOfMonths: 2,
                minDate: 0,
                dateFormat: "mm/dd/yy",
                showOn: "focus"
            });
        });
    }

    function getBirthdateHiddenInput() {
        return document.querySelector('[id$="searchBirthDateInput"]');
    }

    function syncBirthdateValue() {
        var hiddenInput = getBirthdateHiddenInput();
        var yearSelect = document.getElementById('birthYear');
        var monthSelect = document.getElementById('birthMonth');
        var daySelect = document.getElementById('birthDay');
        if (!hiddenInput || !yearSelect || !monthSelect || !daySelect) return;

        hiddenInput.value = yearSelect.value && monthSelect.value && daySelect.value
            ? yearSelect.value + '-' + monthSelect.value + '-' + daySelect.value
            : '';
    }

    function initBirthdateDropdowns() {
        var hiddenInput = getBirthdateHiddenInput();
        var yearSelect = document.getElementById('birthYear');
        var monthSelect = document.getElementById('birthMonth');
        var daySelect = document.getElementById('birthDay');
        if (!hiddenInput || !yearSelect || !monthSelect || !daySelect) return;

        var parts = (hiddenInput.value || '').split('-');
        if (parts.length === 3) {
            yearSelect.value = parts[0];
            monthSelect.value = parts[1];
            daySelect.value = parts[2];
        }
        syncBirthdateValue();
    }

    function initializeAppointmentPage() {
        // Populate the birthdate dropdowns without depending on jQuery.
        // This ensures the year list still loads if the external jQuery CDN is blocked or delayed.
        initBirthdateDropdowns();

        // The appointment date picker still uses jQuery UI, so initialize it only when available.
        if (window.jQuery && jQuery.fn && jQuery.fn.datepicker) {
            initDatePickers();
        }
    }

    if (document.readyState === 'loading') {
        document.addEventListener('DOMContentLoaded', initializeAppointmentPage);
    } else {
        initializeAppointmentPage();
    }
    </script>

</apex:page>