<apex:page controller="C501_AppointmentSchedulerController"
           lightningStylesheets="true"
           showHeader="false"
           sidebar="false"
           docType="html-5.0">

    <!-- jQuery -->
    <script src="https://code.jquery.com/jquery-3.6.0.min.js"></script>

    <!-- jQuery UI -->
    <script src="https://code.jquery.com/ui/1.13.2/jquery-ui.min.js"></script>

    <!-- CSS -->
    <link rel="stylesheet" href="https://code.jquery.com/ui/1.13.2/themes/base/jquery-ui.css"/>

    <style>
        header, footer { background-color: white; }
        body {
            background-color: #FFF;
            font: 16px/1.4em "Helvetica Neue", Helvetica, Arial, sans-serif;
            line-height: 20.8px;
            color: #222;
        }
        input, textarea, select, button {
            font: 16px/1.4em "Helvetica Neue", Helvetica, Arial, sans-serif;
            line-height: 20.8px;
        }
        body .bPageBlock,
        body #bodyCell .bResource .secondaryPalette,
        body .secondaryPalette.bPageBlock,
        body .individualPalette .secondaryPalette.bPageBlock,
        body .bodyDiv .genericTable,
        body .genericPageBlockTable,
        body .bodyDiv .bSubBlock,
        body .bComponentBlock .bPageBlock,
        body .bMyDashboard .bPageBlock,
        body.rlHoverFrame .bPageBlock,
        body.subjectSelectionPopup div.choicesBox,
        body.lookupTab .secondaryPalette.bPageBlock,
        body.popupTab .secondaryPalette.bPageBlock,
        body.UserTagStatsPage .secondaryPalette.bPageBlock {
            background: #FFF;
        }

        .button-row-center {
            text-align: center;
            margin: 20px 0;
        }
        .scheduler-wrap {
            max-width: 760px;
            margin: 0 auto;
        }
        .scheduler-title {
            white-space: nowrap;
            text-align: center;
            font-size: clamp(22px, 2.2vw, 28px);
            margin: 10px 0 20px 0;
            font-weight: 700;
            line-height: 1.3;
        }
        @media (max-width: 768px) {
            .scheduler-title {
                white-space: normal;
            }
        }
        .scheduler-subtitle {
            font-size: 22px;
            margin: 0 0 12px 0;
            font-weight: 700;
            line-height: 1.4;
        }
        .scheduler-copy {
            font-size: 16px;
            line-height: 1.6;
            margin: 10px 0 15px 0;
        }

        .scheduler-copy div {
            margin-bottom: 6px;
        }
        .scheduler-help {
            font-size: 18px;
            margin: 0 0 14px 0;
            line-height: 1.7;
        }
        .scheduler-confirm-row {
            font-size: 18px;
            margin: 0 0 12px 0;
            line-height: 1.6;
        }

        .scheduler-button {
            background: #f05a28;
            color: #fff;
            border: none;
            border-radius: 8px;
            font-size: 22px;
            font-weight: 700;
            padding: 18px 28px;
            cursor: pointer;
            box-shadow:
                0 4px 10px rgba(0,0,0,0.25),
                0 0 0 6px rgba(240, 90, 40, 0.25);
        }
        .scheduler-button.large-button {
            font-size: 22px;
            padding: 18px 28px;
            width: 100%;
            max-width: 400px;
        }
        .scheduler-button:hover {
            background: #d94f22;
        }
        .scheduler-button:active {
            transform: scale(0.98);
        }
        .scheduler-button.secondary {
            background: #666;
            box-shadow: 0 4px 10px rgba(0,0,0,0.20);
        }
        .service-hours-box {
            background: #f9f9f9;
            border: 2px solid #d8dde6;
            padding: 16px;
            margin: 20px auto;        /* centers the box */
            max-width: 500px;         /* keeps it from stretching too wide */
            text-align: center;       /* centers title */
        }

        .service-hours-title {
            font-size: 20px;
            font-weight: 700;
            margin-bottom: 10px;
            text-align: center;
        }

        .service-hours-list {
            font-size: 18px;
            line-height: 1.8;
            text-align: left;         /* keeps list readable */
            display: inline-block;    /* allows centering of block */
        }
        .day-section {
            margin-bottom: 20px;
        }
        .day-checkbox {
            display: block;
            margin: 8px 0 16px 0;
        }
        .field-label {
            display: block;
            font-weight: 700;
            margin: 0 0 6px 0;
            font-size: 20px;
        }
        .field-help {
            display: block;
            margin: 4px 0 10px 0;
            font-size: 15px;
            color: #555;
        }
        .full-width-select,
        .full-width-input {
            width: 100%;
            max-width: 100%;
            box-sizing: border-box;
            font-size: 18px;
            min-height: 42px;
        }
        .check-label {
            font-size: 18px;
            font-weight: 700;
            vertical-align: middle;
            margin-left: 6px;
        }

        .birthdate-selects {
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
            gap: 12px;
            width: 100%;
        }
        .birthdate-select-group label {
            display: block;
            font-size: 16px;
            font-weight: 700;
            margin-bottom: 6px;
        }
        .birthdate-select {
            width: 100%;
            min-height: 46px;
            box-sizing: border-box;
            font-size: 18px;
            padding: 8px;
        }
        .birthdate-select:disabled {
            background: #f3f3f3;
            color: #777;
        }
        @media (max-width: 520px) {
            .birthdate-selects {
                grid-template-columns: 1fr;
            }
        }

        .welcome-box {
            background: #fff;
            border: 1px solid #d8dde6;
            padding: 20px;
            margin-bottom: 20px;
        }
        .welcome-section-title {
            font-size: 22px;
            font-weight: 700;
            margin: 18px 0 10px 0;
            line-height: 1.4;
        }
        .welcome-list {
            margin: 0 0 16px 28px;
            font-size: 20px;
            line-height: 1.8;
        }
        .welcome-list li {
            margin-bottom: 8px;
        }
        .welcome-divider {
            border: 0;
            border-top: 2px solid #d8dde6;
            margin: 18px 0;
        }

        .lookup-fields {
            padding: 12px 0;
        }
        .lookup-field-row {
            margin-bottom: 18px;
        }

        a:link, a:visited {
            color: blue;
        }

        footer a {
            display: inline-block;
            margin: 4px 0;
        }        
    </style>

    <header>
        <br/>

        <apex:outputPanel rendered="{!isGuestUser}" layout="block" style="text-align: center;">
            <img src="{!$Resource.Logo_Client}" height="100px"/>
        </apex:outputPanel>
    </header>

    <div class="scheduler-wrap">
        <apex:form id="frm">
            <apex:pageMessages id="msgs"/>

            <apex:outputPanel rendered="{!isStep1}">
                <div class="scheduler-title">Welcome to the White Center Food Bank Appointment Scheduler</div>

                <div style="text-align:center;">
                    <apex:commandButton value="👉 Continue to Scheduling →"
                                        action="{!startLookup}"
                                        rerender="frm"
                                        styleClass="scheduler-button large-button"/>
                </div>

                <br/>

                <div class="welcome-box">
                    <div class="welcome-section-title">New customers</div>
                    <div class="scheduler-copy">
                        Visit us during distribution hours<br/>
                        請在分配時間內光臨。<br/>
                        Xin vui lòng đến trong thời gian phân phối<br/>
                        សូមមកទស្សនាយើងក្នុងអំឡុងម៉ោងចែកចាយ<br/>
                        Visítanos durante el horario de distribución
                    </div>

                    <hr class="welcome-divider"/>

                    <div class="welcome-section-title">Returning customers</div>
                    <div class="scheduler-copy">
                        Click <strong>Continue</strong>. Then enter your Last Name and Birthdate to schedule an appointment.
                    </div>
                </div>

                <div style="text-align:center; margin-top:20px;">
                    <apex:commandButton value="👉 Continue to Scheduling →"
                                        action="{!startLookup}"
                                        rerender="frm"
                                        styleClass="scheduler-button large-button"/>
                </div>
            </apex:outputPanel>

            <apex:outputPanel rendered="{!isStep2}">
                <div class="scheduler-title">Find your record</div>
                <div class="scheduler-copy">Please provide your Last Name and Birthdate to continue.</div>

                <apex:pageBlock mode="edit">
                    <div class="lookup-fields">
                        <div class="lookup-field-row">
                            <apex:outputLabel value="Last Name"
                                              styleClass="field-label"
                                              for="searchLastNameInput"/>
                            <apex:inputText id="searchLastNameInput"
                                            value="{!searchLastNameText}"
                                            styleClass="full-width-input"/>
                        </div>

                        <div class="lookup-field-row">
                            <apex:outputLabel value="Birthdate"
                                              styleClass="field-label"/>

                            <apex:inputHidden id="searchBirthDateInput"
                                              value="{!searchBirthDateText}"/>

                            <div class="birthdate-selects" role="group" aria-label="Birthdate">
                                <div class="birthdate-select-group">
                                    <label for="birthYear">Year</label>
                                    <select id="birthYear" class="birthdate-select" onchange="syncBirthdateValue();">
